exports[`every template > keeps the text of account_new (ar) 1`] = `
"Ahmed Alzubairi


SAMPLE-CLIENTNAME

أنشأ sample-clientName حساباً جديداً في الموقع.

يمكنك عرض الحساب من لوحة التحكم.

فتح لوحة التحكم https://site.example/ar/dashboard

Ahmed Alzubairi
هذه رسالة آلية، يرجى عدم الرد عليها."
`;

exports[`every template > keeps the text of account_new (en) 1`] = `
