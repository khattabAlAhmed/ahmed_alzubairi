                                      style='font-size:13px;line-height:1.45;margin:0;padding:16px 0 0;border-top:1px solid #D5D8DA;color:#50555A;font-family:Alexandria, "Noto Sans Arabic", -apple-system, BlinkMacSystemFont, "Segoe UI", Tahoma, "Geeza Pro", Roboto, Arial, sans-serif;font-weight:400;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0'>
                                      <span dir="auto" translate="no"
                                        >Ahmed Alzubairi</span
                                      ><br />This is an automated message.
                                      Please don&#x27;t reply to it.
                                    </p>
                                  </td>
                                </tr>
                              </tbody>
                            </table>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </td>
                </tr>
              </tbody>
            </table>
          </td>
        </tr>
      </tbody>
    </table>
    <!--/$-->
  </body>
</html>
"
`;

