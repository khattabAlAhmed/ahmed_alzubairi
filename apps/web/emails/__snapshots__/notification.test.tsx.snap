      :root { color-scheme: light dark; supported-color-schemes: light dark; }
      @media (prefers-color-scheme: dark) {
        .em-body, .em-body > table > tbody > tr > td { background-color: #101213 !important; }
        .em-rule { border-top-color: #E6E8E9 !important; }
        .em-line { border-top-color: #2A2E30 !important; }
        .em-details { border-bottom-color: #2A2E30 !important; }
        .em-text { color: #E6E8E9 !important; }
        .em-muted { color: #9DA3A7 !important; }
        .em-button { background-color: #74C7C7 !important; color: #101213 !important; }
      }
      [data-ogsc] .em-body, [data-ogsc] .em-body > table > tbody > tr > td { background-color: #101213 !important; }
        [data-ogsc] .em-rule { border-top-color: #E6E8E9 !important; }
        [data-ogsc] .em-line { border-top-color: #2A2E30 !important; }
        [data-ogsc] .em-details { border-bottom-color: #2A2E30 !important; }
        [data-ogsc] .em-text { color: #E6E8E9 !important; }
        [data-ogsc] .em-muted { color: #9DA3A7 !important; }
        [data-ogsc] .em-button { background-color: #74C7C7 !important; color: #101213 !important; }
      [data-ogsb] .em-body { background-color: #101213 !important; }
      @media (max-width: 480px) {
        .em-page { padding-left: 16px !important; padding-right: 16px !important; }
      }
    </style>
  </head>
  <body
    lang="en"
    dir="ltr"
    class="em-body"
    style="background-color:#FFFFFF;margin:0;padding:0">
    <!--$--><!--html--><!--head--><!--body-->
    <table
      border="0"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      role="presentation"
      align="center">
      <tbody>
        <tr>
          <td
            style='margin:0;padding:24px 0;background-color:#FFFFFF;font-family:Alexandria, "Noto Sans Arabic", -apple-system, BlinkMacSystemFont, "Segoe UI", Tahoma, "Geeza Pro", Roboto, Arial, sans-serif'>
            <div
              style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0"
              data-skip-in-text="true">
              sample-memberName added a recommendation on the request for the
              document “sample-documentTitle”.
              <div>
                 ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿
              </div>
            </div>
            <table
              align="center"
              width="100%"
              lang="en"
              dir="ltr"
              border="0"
              cellpadding="0"
              cellspacing="0"
              role="presentation"
              style="max-width:600px;width:100%;margin:0 auto">
