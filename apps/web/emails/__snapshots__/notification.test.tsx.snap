"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html dir="ltr" lang="en">
  <head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
    <meta name="x-apple-disable-message-reformatting" />
    <meta name="color-scheme" content="light dark" />
    <meta name="supported-color-schemes" content="light dark" />
    <style>
      :root { color-scheme: light dark; supported-color-schemes: light dark; }
      @media (prefers-color-scheme: dark) {
        .em-body, .em-body > table > tbody > tr > td { background-color: #101213 !important; }
        .em-rule { border-top-color: #E6E8E9 !important; }
        .em-line { border-top-color: #2A2E30 !important; }
        .em-details { border-bottom-color: #2A2E30 !important; }
        .em-text { color: #E6E8E9 !important; }
        .em-muted { color: #9DA3A7 !important; }
        .em-button { background-color: #74C7C7 !important; color: #101213 !important; }
      }
      [data-ogsc] .em-body, [data-ogsc] .em-body > table > tbody > tr > td { background-color: #101213 !important; }
        [data-ogsc] .em-rule { border-top-color: #E6E8E9 !important; }
        [data-ogsc] .em-line { border-top-color: #2A2E30 !important; }
        [data-ogsc] .em-details { border-bottom-color: #2A2E30 !important; }
        [data-ogsc] .em-text { color: #E6E8E9 !important; }
        [data-ogsc] .em-muted { color: #9DA3A7 !important; }
        [data-ogsc] .em-button { background-color: #74C7C7 !important; color: #101213 !important; }
      [data-ogsb] .em-body { background-color: #101213 !important; }
      @media (max-width: 480px) {
        .em-page { padding-left: 16px !important; padding-right: 16px !important; }
      }
    </style>
  </head>
  <body
    lang="en"
    dir="ltr"
    class="em-body"
    style="background-color:#FFFFFF;margin:0;padding:0">
    <!--$--><!--html--><!--head--><!--body-->
    <table
      border="0"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      role="presentation"
      align="center">
      <tbody>
        <tr>
          <td
            style='margin:0;padding:24px 0;background-color:#FFFFFF;font-family:Alexandria, "Noto Sans Arabic", -apple-system, BlinkMacSystemFont, "Segoe UI", Tahoma, "Geeza Pro", Roboto, Arial, sans-serif'>
            <div
              style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0"
              data-skip-in-text="true">
              sample-clientName asked to view the document
              “sample-documentTitle”.
              <div>
                 ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿
              </div>
            </div>
            <table
              align="center"
              width="100%"
              lang="en"
              dir="ltr"
              border="0"
              cellpadding="0"
              cellspacing="0"
              role="presentation"
              style="max-width:600px;width:100%;margin:0 auto">
              <tbody>
                <tr style="width:100%">
                  <td>
                    <table
                      align="center"
                      width="100%"
                      border="0"
                      cellpadding="0"
                      cellspacing="0"
                      role="presentation">
                      <tbody>
                        <tr>
                          <td>
                            <table
                              align="center"
                              width="100%"
                              border="0"
                              cellpadding="0"
                              cellspacing="0"
                              role="presentation">
                              <tbody style="width:100%">
                                <tr style="width:100%">
                                  <td
                                    class="em-page"
                                    data-id="__react-email-column"
                                    style="padding:0 24px">
                                    <p
                                      class="em-text em-rule"
                                      style='font-size:17px;line-height:1.5;margin:0;padding:16px 0 0;border-top:2px solid #1A1C1E;color:#1A1C1E;font-family:Alexandria, "Noto Sans Arabic", -apple-system, BlinkMacSystemFont, "Segoe UI", Tahoma, "Geeza Pro", Roboto, Arial, sans-serif;font-weight:500;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0'>
                                      <span dir="auto" translate="no"
                                        >Ahmed Alzubairi</span
                                      >
                                    </p>
                                  </td>
                                </tr>
                              </tbody>
                            </table>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                    <table
                      align="center"
                      width="100%"
                      border="0"
                      cellpadding="0"
                      cellspacing="0"
                      role="presentation">
                      <tbody>
                        <tr>
                          <td>
                            <table
                              align="center"
                              width="100%"
                              border="0"
                              cellpadding="0"
                              cellspacing="0"
                              role="presentation">
                              <tbody style="width:100%">
                                <tr style="width:100%">
                                  <td
                                    class="em-page"
                                    data-id="__react-email-column"
                                    style="padding:40px 24px 16px">
                                    <h1
                                      class="em-text"
                                      style='margin:0 0 24px;color:#1A1C1E;font-family:Alexandria, "Noto Sans Arabic", -apple-system, BlinkMacSystemFont, "Segoe UI", Tahoma, "Geeza Pro", Roboto, Arial, sans-serif;font-size:26px;line-height:1.25;font-weight:500;overflow-wrap:anywhere'>
                                      <span dir="auto"
                                        >sample-documentTitle</span
                                      >
                                    </h1>
                                    <p
                                      class="em-text"
                                      style='font-size:16px;line-height:1.6;margin:0 0 16px;color:#1A1C1E;font-family:Alexandria, "Noto Sans Arabic", -apple-system, BlinkMacSystemFont, "Segoe UI", Tahoma, "Geeza Pro", Roboto, Arial, sans-serif;font-weight:400;overflow-wrap:anywhere;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0'>
                                      sample-clientName asked to view the
                                      document “sample-documentTitle”.
                                    </p>
                                    <p
                                      class="em-text"
                                      style='font-size:16px;line-height:1.6;margin:0 0 16px;color:#1A1C1E;font-family:Alexandria, "Noto Sans Arabic", -apple-system, BlinkMacSystemFont, "Segoe UI", Tahoma, "Geeza Pro", Roboto, Arial, sans-serif;font-weight:400;overflow-wrap:anywhere;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0'>
                                      Open the dashboard to review the request.
                                    </p>
                                    <table
                                      align="center"
                                      width="100%"
                                      border="0"
                                      cellpadding="0"
                                      cellspacing="0"
                                      role="presentation"
                                      style="margin:8px 0 32px">
                                      <tbody>
                                        <tr>
                                          <td>
                                            <a
                                              href="https://site.example/en/dashboard"
                                              class="em-button"
                                              style='line-height:1.5;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;padding:12px 24px;background-color:#0E5C61;border-radius:0;color:#FFFFFF;font-family:Alexandria, "Noto Sans Arabic", -apple-system, BlinkMacSystemFont, "Segoe UI", Tahoma, "Geeza Pro", Roboto, Arial, sans-serif;font-size:16px;font-weight:500;padding-top:12px;padding-right:24px;padding-bottom:12px;padding-left:24px'
                                              target="_blank"
                                              ><span
                                                ><!--[if mso]><i style="mso-font-width:400%;mso-text-raise:18" hidden>&#8202;&#8202;&#8202;</i><![endif]--></span
                                              ><span
                                                style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px"
                                                >Open the dashboard</span
                                              ><span
                                                ><!--[if mso]><i style="mso-font-width:400%" hidden>&#8202;&#8202;&#8202;&#8203;</i><![endif]--></span
                                              ></a
                                            >
                                          </td>
                                        </tr>
                                      </tbody>
                                    </table>
                                  </td>
                                </tr>
                              </tbody>
                            </table>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                    <table
                      align="center"
                      width="100%"
                      border="0"
                      cellpadding="0"
                      cellspacing="0"
                      role="presentation">
                      <tbody>
                        <tr>
                          <td>
                            <table
                              align="center"
                              width="100%"
                              border="0"
                              cellpadding="0"
                              cellspacing="0"
                              role="presentation">
                              <tbody style="width:100%">
                                <tr style="width:100%">
                                  <td
                                    class="em-page"
                                    data-id="__react-email-column"
                                    style="padding:0 24px">
                                    <p
                                      class="em-muted em-line"
                                      style='font-size:13px;line-height:1.45;margin:0;padding:16px 0 0;border-top:1px solid #D5D8DA;color:#50555A;font-family:Alexandria, "Noto Sans Arabic", -apple-system, BlinkMacSystemFont, "Segoe UI", Tahoma, "Geeza Pro", Roboto, Arial, sans-serif;font-weight:400;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0'>
                                      <span dir="auto" translate="no"
                                        >Ahmed Alzubairi</span
                                      ><br />This is an automated message.
                                      Please don&#x27;t reply to it.
                                    </p>
                                  </td>
                                </tr>
                              </tbody>
                            </table>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </td>
                </tr>
              </tbody>
            </table>
          </td>
        </tr>
      </tbody>
    </table>
    <!--/$-->
  </body>
</html>
"
`;

